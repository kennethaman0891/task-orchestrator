# ─────────────────────────────────────────────────────────────────────────────
# TTO Remote Control (WhatsApp via OpenWA) — environment configuration
# Copy to ~/tto-web/.env (or ~/tto-web/backend/.env) and fill in your values.
# All remote vars are OPTIONAL — TTO works perfectly with nothing set.
# ─────────────────────────────────────────────────────────────────────────────
#
# ⚠️  SECURITY NOTES
# ──────────────────
# 1. Never commit a filled-in .env to git (it is already in .gitignore).
# 2. Restrict file permissions after creating it:
#       chmod 600 .env backend/.env
# 3. Generate strong secrets with:
#       python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 4. Rotate secrets if they may have been exposed:
#       - Telegram token  →  @BotFather → /revoke → /token
#       - Groq API key    →  https://console.groq.com/keys → Delete & regenerate
#       - OpenWA secret   →  generate a new value (see step 3 above)
# ─────────────────────────────────────────────────────────────────────────────

# Master switches. Set BOTH to true to enable the remote subsystem.
TTO_REMOTE_ENABLED=false
OPENWA_ENABLED=false

# ── OpenWA connection ────────────────────────────────────────────────────────
# OpenWA is an external local service (https://github.com/rmyndharis/OpenWA),
# default port 2785 (no conflict with TTO's 8765).
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=tto-remote

# OpenWA's OWN .env (at ~/OpenWA/.env) must allow webhook delivery to the
# local TTO sidecar — add this there and restart OpenWA:
#   SSRF_ALLOWED_HOSTS=127.0.0.1
OPENWA_TIMEOUT=8
OPENWA_RETRIES=2

# ── Webhook ─────────────────────────────────────────────────────────────────
# Secret used to authenticate OpenWA's webhook calls to TTO.
# Register the webhook in OpenWA pointing at:
#   http://127.0.0.1:8765/api/remote/whatsapp/webhook
# with this secret in the X-Webhook-Secret header.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPENWA_WEBHOOK_SECRET=

# ── Authorization (send allowlist) ──────────────────────────────────────────
# ONLY these senders may control TTO. Comma/space separated.
# Prefer chat ids; phone numbers also work (with or without + and @c.us suffix).
OPENWA_ALLOWED_CHAT_IDS=
OPENWA_ALLOWED_PHONE_NUMBERS=

# ── Command policy ──────────────────────────────────────────────────────────
TTO_REMOTE_RATE_LIMIT=30          # max commands per sender per minute
TTO_REMOTE_CONFIRM_TTL=60         # confirmation token lifetime (seconds)
TTO_REMOTE_LOGS_MAX=200           # max log lines /logs can return
TTO_REMOTE_LOGS_DEFAULT=30

# ── Proactive notifications (all optional, default true) ────────────────────
TTO_REMOTE_NOTIFY_TASK_COMPLETE=true
TTO_REMOTE_NOTIFY_TASK_FAILED=true
TTO_REMOTE_NOTIFY_AGENT_WAITING=true
TTO_REMOTE_NOTIFY_TERMINAL_CRASH=true
TTO_REMOTE_NOTIFY_SYSTEM_ERROR=true
TTO_REMOTE_NOTIFY_MIN_INTERVAL=30  # cooldown seconds per notification category

# ── Discord bot (alternative transport — slash commands only) ─────────────────
# Get a token from https://discord.com/developers/applications → Bot → Token.
# Enable MESSAGE CONTENT intent under Bot → Privileged Gateway Intents.
# Rotate token at: https://discord.com/developers/applications → Bot → Reset Token
DISCORD_BOT_TOKEN=

# ── Audit log (optional path; secrets are never written) ────────────────────
TTO_REMOTE_AUDIT_LOG=

# ── Voice / STT (optional) ───────────────────────────────────────────────────
# Groq Whisper speech-to-text (free tier: 14 400 min/month).
# Get a key at https://console.groq.com/keys — rotate there if exposed.
TTO_GROQ_API_KEY=

# ── Telegram bot (alternative transport) ─────────────────────────────────────
# Get a token from @BotFather (Telegram → /newbot). Rotate via /revoke → /token.
TTO_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_POLL_INTERVAL=1
