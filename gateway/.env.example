# ─────────────────────────────────────────────────────────────────────────────
# TTO Gateway — environment configuration
# Copy to gateway/.env (or export in your shell / service manager).
# ─────────────────────────────────────────────────────────────────────────────

# Listen address + ports
TTO_GATEWAY_HOST=0.0.0.0
TTO_GATEWAY_WSS_PORT=8787
TTO_GATEWAY_HTTP_PORT=8788

# First-run bootstrap admin (used to create the initial user)
TTO_GATEWAY_ADMIN_USERNAME=admin
TTO_GATEWAY_ADMIN_PASSWORD=change-me-now

# SQLite storage (swappable for Postgres — see README "Production")
TTO_GATEWAY_DB=./data/tto-gateway.db

# TLS cert/key → enables WSS (REQUIRED for production/internet use).
# Generate with: openssl req -x509 -newkey rsa:2048 -nodes \
#   -keyout gateway/certs/key.pem -out gateway/certs/cert.pem -days 825 -subj "/CN=tto-gateway"
TTO_GATEWAY_TLS_CERT=./certs/cert.pem
TTO_GATEWAY_TLS_KEY=./certs/key.pem

# Public URL clients should use to reach this gateway (wss://host:port)
TTO_GATEWAY_PUBLIC_URL=wss://your-host.example:8787

# Static phone/web client (optional; point at a built client)
TTO_GATEWAY_WEB_CLIENT=./client-dist

# Tuning (ms)
TTO_GATEWAY_ACCESS_TTL_MS=900000        # 15 min
TTO_GATEWAY_REFRESH_TTL_MS=2592000000   # 30 days
TTO_GATEWAY_PAIRING_TTL_MS=600000       # 10 min
TTO_GATEWAY_HEARTBEAT_MS=15000
TTO_GATEWAY_OFFLINE_AFTER_MS=60000

# Rate limits (per minute, per IP)
TTO_GATEWAY_MAX_AUTH_PER_MIN=10
TTO_GATEWAY_MAX_PAIRING_PER_MIN=5

# Max inbound message size (bytes)
TTO_GATEWAY_MAX_MSG_BYTES=262144

# Verbose protocol logging (message names only — never payloads)
TTO_GATEWAY_VERBOSE=0